{
  "id": "papier",
  "name": "Papier",
  "author": "Exemple",
  "version": "1.0.0",
  "description": "Thème d'exemple : clair, couleurs de papier, polices système, bibliothèque en liste.",
  "vars": {
    "--bg": "#f3efe6",
    "--surface": "#fbf8f1",
    "--surface-2": "#ebe5d8",
    "--text": "#22201c",
    "--muted": "#7a7468",
    "--line": "#d9d1c0",
    "--accent": "#c2410c",
    "--on-accent": "#fffaf2",
    "--danger": "#b91c1c",
    "--font-sans": "Georgia, 'Times New Roman', serif",
    "--font-mono": "Consolas, 'Courier New', monospace",
    "--radius-s": "10px",
    "--radius-m": "14px",
    "--radius-l": "22px",
    "--shadow-card": "0 10px 24px rgba(60, 45, 20, .16)",
    "--focus-ring": "0 0 0 3px #c2410c",
